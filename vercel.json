{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/work", "destination": "/experience", "permanent": true },
    { "source": "/work.html", "destination": "/experience", "permanent": true },
    { "source": "/resume_cs", "destination": "/resume", "permanent": true },
    { "source": "/resume_cs.html", "destination": "/resume", "permanent": true },
    { "source": "/resume_full", "destination": "/resume", "permanent": true },
    { "source": "/resume_full.html", "destination": "/resume", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\.(jpg|png|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
